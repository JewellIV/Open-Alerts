PORT=3000

# Room speakers: comma-separated list. Format: roomId:Unit1|Unit2,roomId2:Unit3
# Example: engine_bay:Engine 1|Ladder 2,living_room:Medic 3|Engine 2
# ROOM_SPEAKERS=

# When the main server runs on Windows (no GPIO), point each room at its Pi GPIO service.
# Format: roomId:http://ROOM_PI_IP:4000,roomId2:http://OTHER_PI_IP:4000
# ROOM_GPIO_URLS=mens_bunk:http://192.168.68.140:4000,engine_bay:http://192.168.68.141:4000

# Engine-bay Pi that still has the amplifier / radio relays (GPIO 18 / 23)
# AMPLIFIER_GPIO_URL=http://192.168.68.141:4000
# RADIO_GPIO_PIN=23

# LED Ring Configuration (optional)
# Enable RGB LED ring control for visual alert indication
LED_RING_ENABLED=false
LED_RING_PIN=18
LED_RING_COUNT=24
LED_RING_BRIGHTNESS=128
